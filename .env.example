OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT=120
# Remote hosts are rejected by default. Enabling this sends prompts and retrieved
# private memory to OLLAMA_HOST; use only a host you control and trust.
ALLOW_REMOTE_OLLAMA=false
MAX_HISTORY_MESSAGES=12
